{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Follow-Up Sequence Writer Output",
  "type": "object",
  "properties": {
    "meeting_type": {
      "type": "string",
      "enum": ["Discovery", "Demo", "Proposal", "Executive", "QBR"]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["name", "title"]
      }
    },
    "key_discussion_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitments": {
      "type": "object",
      "properties": {
        "by_us": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by_them": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["by_us", "by_them"]
    },
    "next_step_agreed": {
      "type": "string"
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email_number": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": ["email_number", "label", "timing", "subject", "body", "purpose"]
      }
    },
    "sequence_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "integer"
          },
          "timing": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "sent", "skipped"]
          }
        },
        "required": ["email", "timing", "status"]
      }
    }
  },
  "required": [
    "meeting_type",
    "participants",
    "key_discussion_points",
    "commitments",
    "emails",
    "sequence_calendar"
  ]
}
