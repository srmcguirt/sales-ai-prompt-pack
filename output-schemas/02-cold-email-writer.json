{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cold Email Writer Output",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "product": {
          "type": "string"
        }
      },
      "required": ["account", "contact", "title", "trigger", "product"]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": ["A", "B", "C"]
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "word_count": {
            "type": "integer"
          },
          "personalization_signal": {
            "type": "string"
          },
          "why_this_variant": {
            "type": "string"
          }
        },
        "required": ["variant", "subject", "body", "word_count", "personalization_signal", "why_this_variant"]
      }
    },
    "subject_line_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string"
          },
          "why_it_works": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        },
        "required": ["variant", "why_it_works", "risk"]
      }
    },
    "recommended_send_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer"
          },
          "variant": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["day", "variant", "note"]
      }
    }
  },
  "required": [
    "context",
    "variants",
    "subject_line_analysis",
    "recommended_send_sequence"
  ]
}
