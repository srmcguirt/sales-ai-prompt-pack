{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Win/Loss Analyzer Output",
  "type": "object",
  "properties": {
    "analysis_period": {
      "type": "string"
    },
    "deals_analyzed": {
      "type": "object",
      "properties": {
        "won": {
          "type": "integer"
        },
        "lost": {
          "type": "integer"
        },
        "total_pipeline_value": {
          "type": "string"
        }
      },
      "required": ["won", "lost", "total_pipeline_value"]
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_note": {
      "type": "string"
    },
    "executive_summary": {
      "type": "object",
      "properties": {
        "overall_win_rate": {
          "type": "object",
          "properties": {
            "current": {
              "type": "string"
            },
            "prior_period": {
              "type": "string"
            },
            "benchmark": {
              "type": "string"
            }
          },
          "required": ["current", "prior_period", "benchmark"]
        },
        "top_win_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["factor", "evidence"]
          }
        },
        "top_loss_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "factor": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["factor", "evidence"]
          }
        },
        "key_recommendation": {
          "type": "string"
        }
      },
      "required": ["overall_win_rate", "top_win_drivers", "top_loss_drivers", "key_recommendation"]
    },
    "win_pattern_analysis": {
      "type": "object",
      "properties": {
        "by_segment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segment": {
                "type": "string"
              },
              "win_rate": {
                "type": "string"
              },
              "avg_deal_size": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["segment", "win_rate", "avg_deal_size", "notes"]
          }
        },
        "by_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string"
              },
              "conversion_rate": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["stage", "conversion_rate", "notes"]
          }
        },
        "win_characteristics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": ["High", "Med", "Low"]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["finding", "confidence", "evidence"]
          }
        }
      },
      "required": ["by_segment", "by_stage", "win_characteristics"]
    },
    "loss_pattern_analysis": {
      "type": "object",
      "properties": {
        "by_reason": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              },
              "pct_of_losses": {
                "type": "string"
              },
              "weighted_acv": {
                "type": "string"
              },
              "actionable": {
                "type": "string"
              }
            },
            "required": ["reason", "pct_of_losses", "weighted_acv", "actionable"]
          }
        },
        "loss_characteristics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": ["High", "Med", "Low"]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["pattern", "confidence", "evidence"]
          }
        }
      },
      "required": ["by_reason", "loss_characteristics"]
    },
    "competitive_analysis": {
      "type": "object",
      "properties": {
        "by_competitor": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "competitor": {
                "type": "string"
              },
              "deals": {
                "type": "integer"
              },
              "win_rate": {
                "type": "string"
              },
              "when_we_win": {
                "type": "string"
              },
              "when_we_lose": {
                "type": "string"
              }
            },
            "required": ["competitor", "deals", "win_rate", "when_we_win", "when_we_lose"]
          }
        },
        "displacement_trend": {
          "type": "string"
        }
      },
      "required": ["by_competitor", "displacement_trend"]
    },
    "buyer_interview_themes": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "won": {
              "type": "integer"
            },
            "lost": {
              "type": "integer"
            }
          },
          "required": ["total", "won", "lost"]
        },
        "won_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": ["theme", "quote"]
          }
        },
        "lost_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": ["theme", "quote"]
          }
        },
        "surprises": {
          "type": "string"
        }
      },
      "required": ["sample", "won_themes", "lost_themes", "surprises"]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "integer"
          },
          "recommendation": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expected_impact": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": ["High", "Med", "Low"]
          }
        },
        "required": ["priority", "recommendation", "owner", "expected_impact", "confidence"]
      }
    },
    "stop_doing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_more_of": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_investigation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_notes": {
      "type": "object",
      "properties": {
        "sample_size": {
          "type": "string"
        },
        "selection_bias": {
          "type": "string"
        },
        "recency": {
          "type": "string"
        }
      },
      "required": ["sample_size", "selection_bias", "recency"]
    }
  },
  "required": [
    "analysis_period",
    "deals_analyzed",
    "data_sources",
    "executive_summary",
    "win_pattern_analysis",
    "loss_pattern_analysis",
    "recommendations"
  ]
}
