{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Writer Output",
  "type": "object",
  "properties": {
    "prepared_for": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": ["company", "contact", "title"]
    },
    "prepared_by": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "valid_through": {
      "type": "string"
    },
    "executive_summary": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "investment": {
          "type": "string"
        },
        "timeline_to_value": {
          "type": "string"
        }
      },
      "required": ["problem", "solution", "result", "investment", "timeline_to_value"]
    },
    "their_situation": {
      "type": "string",
      "description": "Narrative section in the prospect's language"
    },
    "proposed_solution": {
      "type": "object",
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string"
              },
              "addresses": {
                "type": "string"
              }
            },
            "required": ["feature", "addresses"]
          }
        },
        "not_included": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["item", "reason"]
          }
        }
      },
      "required": ["included", "not_included"]
    },
    "business_case": {
      "type": "object",
      "properties": {
        "current_state_costs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cost_element": {
                "type": "string"
              },
              "current": {
                "type": "string"
              },
              "with_product": {
                "type": "string"
              },
              "annual_savings": {
                "type": "string"
              }
            },
            "required": ["cost_element", "current", "with_product", "annual_savings"]
          }
        },
        "total_annual_savings": {
          "type": "string"
        },
        "payback_period": {
          "type": "string"
        },
        "three_year_roi": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["current_state_costs", "total_annual_savings", "payback_period", "three_year_roi", "assumptions"]
    },
    "implementation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "milestones": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": ["phase", "duration", "milestones", "owner"]
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string"
              },
              "included": {
                "type": "string"
              },
              "price": {
                "type": "string"
              }
            },
            "required": ["tier", "included", "price"]
          }
        },
        "not_included_in_any_tier": {
          "type": "string"
        },
        "payment_terms": {
          "type": "string"
        },
        "contract_length": {
          "type": "string"
        }
      },
      "required": ["tiers", "not_included_in_any_tier", "payment_terms", "contract_length"]
    },
    "why_us": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "use_case": {
            "type": "string"
          },
          "available": {
            "type": "string"
          }
        },
        "required": ["company", "use_case", "available"]
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "prepared_for",
    "prepared_by",
    "date",
    "valid_through",
    "executive_summary",
    "their_situation",
    "proposed_solution",
    "business_case",
    "implementation_plan",
    "pricing",
    "next_steps"
  ]
}
